# Copy values into your shell or repo .env when running the testserver against local LGTM.
# Grafana UI is on 3001 (testserver keeps ACP HTTP on 3000).

# OTLP → OpenTelemetry Collector inside grafana/otel-lgtm
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=tacklr-testserver

# Optional: force HTTP OTLP instead of gRPC
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http

# Testserver ACP HTTP (do not collide with Grafana on 3001)
PORT=3000
