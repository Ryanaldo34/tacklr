# Copy to .dev.vars for wrangler dev; set the same names with
# `wrangler secret put` for a deploy.
API_TOKEN=change-me
# 32 random bytes in base64: openssl rand -base64 32
SEAL_KEY=
# The model: set ANTHROPIC_API_KEY for a Claude model, or OPENAI_API_KEY.
MODEL=gpt-5-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# Optional: where the Worker sends its traces (OTLP/HTTP), and its key.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20your-key
# OTEL_SERVICE_NAME=tacklr-edge
